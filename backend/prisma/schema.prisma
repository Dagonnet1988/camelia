generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoriaProducto {
  arete
  anillo
  manilla
  collar
  otro
}

enum MedioPago {
  contado
  cuotas
}

enum Canal {
  whatsapp
  presencial
}

enum EstadoCuota {
  pendiente
  pagada
  atrasada
}

enum EstadoComision {
  pendiente
  liquidada
}

model Producto {
  codigo        String            @id
  nombre        String
  categoria     CategoriaProducto
  valorVenta    Decimal           @map("valor_venta") @db.Decimal(12, 2)
  costoPromedio Decimal           @default(0) @map("costo_promedio") @db.Decimal(12, 2)
  stockActual   Int               @default(0) @map("stock_actual")
  stockMinimo   Int               @default(0) @map("stock_minimo")
  fechaIngreso  DateTime          @default(now()) @map("fecha_ingreso")

  compras CompraInventario[]
  ventas  Venta[]
  fotos   FotoProducto[]

  @@map("productos")
}

model FotoProducto {
  id             Int      @id @default(autoincrement())
  codigoProducto String   @map("codigo_producto")
  url            String
  orden          Int      @default(0)
  fechaCreacion  DateTime @default(now()) @map("fecha_creacion")

  producto Producto @relation(fields: [codigoProducto], references: [codigo], onDelete: Cascade)

  @@map("fotos_producto")
}

model CompraInventario {
  id                  Int      @id @default(autoincrement())
  codigoProducto      String   @map("codigo_producto")
  cantidad            Int
  valorCompraUnitario Decimal  @map("valor_compra_unitario") @db.Decimal(12, 2)
  proveedor           String?
  fechaCompra         DateTime @default(now()) @map("fecha_compra")

  producto Producto @relation(fields: [codigoProducto], references: [codigo])

  @@map("compras_inventario")
}

model Comprador {
  celular            String    @id
  nombre             String
  fechaPrimeraCompra DateTime? @map("fecha_primera_compra")

  ventas Venta[]

  @@map("compradores")
}

model Venta {
  id                     Int            @id @default(autoincrement())
  codigoProducto         String         @map("codigo_producto")
  compradorCelular       String?        @map("comprador_celular")
  cantidad               Int
  valorContado           Decimal        @map("valor_contado") @db.Decimal(12, 2)
  medioPago              MedioPago      @map("medio_pago")
  numCuotas              Int?           @map("num_cuotas")
  recargoCuotas          Decimal?       @map("recargo_cuotas") @db.Decimal(12, 2)
  valorTotalVenta        Decimal        @map("valor_total_venta") @db.Decimal(12, 2)
  costoPromedioAlMomento Decimal        @map("costo_promedio_al_momento") @db.Decimal(12, 2)
  ganancia               Decimal        @db.Decimal(12, 2)
  canal                  Canal
  fechaVenta             DateTime       @default(now()) @map("fecha_venta")
  vendedorId             Int?           @map("vendedor_id")
  comisionPorcentaje     Decimal        @default(0) @map("comision_porcentaje") @db.Decimal(5, 2)
  comision               Decimal        @default(0) @db.Decimal(12, 2)
  comisionEstado         EstadoComision @default(pendiente) @map("comision_estado")
  liquidacionId          Int?           @map("liquidacion_id")

  producto    Producto     @relation(fields: [codigoProducto], references: [codigo])
  comprador   Comprador?   @relation(fields: [compradorCelular], references: [celular])
  cuotas      Cuota[]
  vendedor    Usuario?     @relation("VentasVendedor", fields: [vendedorId], references: [id])
  liquidacion Liquidacion? @relation(fields: [liquidacionId], references: [id])

  @@map("ventas")
}

model Liquidacion {
  id               Int      @id @default(autoincrement())
  vendedorId       Int      @map("vendedor_id")
  generadaPorId    Int      @map("generada_por_id")
  fechaLiquidacion DateTime @default(now()) @map("fecha_liquidacion")
  totalComision    Decimal  @db.Decimal(12, 2) @map("total_comision")
  cantidadVentas   Int      @map("cantidad_ventas")

  vendedor    Usuario @relation("LiquidacionesVendedor", fields: [vendedorId], references: [id])
  generadaPor Usuario @relation("LiquidacionesGeneradaPor", fields: [generadaPorId], references: [id])
  ventas      Venta[]

  @@map("liquidaciones_comision")
}

model Cuota {
  id               Int         @id @default(autoincrement())
  idVenta          Int         @map("id_venta")
  numeroCuota      Int         @map("numero_cuota")
  valorCuota       Decimal     @map("valor_cuota") @db.Decimal(12, 2)
  fechaVencimiento DateTime    @map("fecha_vencimiento") @db.Date
  fechaPago        DateTime?   @map("fecha_pago") @db.Date
  estado           EstadoCuota @default(pendiente)
  recordatorioEnviado Boolean  @default(false) @map("recordatorio_enviado")

  venta Venta @relation(fields: [idVenta], references: [id])

  @@map("cuotas")
}

model ConfiguracionApp {
  id                         Int     @id @default(1)
  recordatoriosCuotasActivos Boolean @default(true) @map("recordatorios_cuotas_activos")
  limiteMensajesHora         Int?    @default(20) @map("limite_mensajes_hora")
  limiteMensajesDia          Int?    @default(100) @map("limite_mensajes_dia")
  envioMasivoDelayMinSeg     Int     @default(5) @map("envio_masivo_delay_min_seg")
  envioMasivoDelayMaxSeg     Int     @default(15) @map("envio_masivo_delay_max_seg")

  @@map("configuracion_app")
}

enum EstadoMensajeWhatsapp {
  enviado
  fallido
}

model HistorialMensajeWhatsapp {
  id         Int                   @id @default(autoincrement())
  numero     String
  mensaje    String
  tipo       String
  estado     EstadoMensajeWhatsapp
  error      String?
  fechaEnvio DateTime              @default(now()) @map("fecha_envio")

  @@map("historial_mensajes_whatsapp")
}

enum EstadoEnvioMasivo {
  pendiente
  en_progreso
  completado
  cancelado
}

enum EstadoEnvioDestinatario {
  pendiente
  enviado
  fallido
}

model EnvioMasivo {
  id                 Int               @id @default(autoincrement())
  mensaje            String
  estado             EstadoEnvioMasivo @default(pendiente)
  totalDestinatarios Int               @map("total_destinatarios")
  enviados           Int               @default(0)
  fallidos           Int               @default(0)
  fechaCreacion      DateTime          @default(now()) @map("fecha_creacion")
  fechaFin           DateTime?         @map("fecha_fin")

  destinatarios EnvioMasivoDestinatario[]

  @@map("envios_masivos")
}

model EnvioMasivoDestinatario {
  id               Int                     @id @default(autoincrement())
  envioMasivoId    Int                     @map("envio_masivo_id")
  compradorCelular String                  @map("comprador_celular")
  nombre           String
  estado           EstadoEnvioDestinatario @default(pendiente)
  error            String?
  fechaEnvio       DateTime?               @map("fecha_envio")

  envioMasivo EnvioMasivo @relation(fields: [envioMasivoId], references: [id])

  @@map("envios_masivos_destinatarios")
}

enum RolUsuario {
  admin
  manager
  user
}

model Usuario {
  id                  Int        @id @default(autoincrement())
  usuario             String     @unique
  nombre              String
  apellido            String
  rol                 RolUsuario @default(user)
  passwordHash        String     @map("password_hash")
  debeCambiarPassword Boolean    @default(true) @map("debe_cambiar_password")
  porcentajeComision  Decimal    @default(0) @map("porcentaje_comision") @db.Decimal(5, 2)
  fechaCreacion       DateTime   @default(now()) @map("fecha_creacion")

  ventasComoVendedor     Venta[]       @relation("VentasVendedor")
  liquidacionesRecibidas Liquidacion[] @relation("LiquidacionesVendedor")
  liquidacionesGeneradas Liquidacion[] @relation("LiquidacionesGeneradaPor")

  @@map("usuarios")
}
